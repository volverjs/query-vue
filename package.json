{
    "name": "@volverjs/query-vue",
    "type": "module",
    "version": "0.0.0",
    "packageManager": "pnpm@11.7.0",
    "description": "Repository pattern applied to a pinia store.",
    "author": "8 Wave S.r.l.",
    "license": "MIT",
    "homepage": "https://github.com/volverjs/query-vue",
    "repository": {
        "type": "git",
        "url": "https://github.com/volverjs/query-vue"
    },
    "bugs": {
        "url": "https://github.com/volverjs/query-vue/issues"
    },
    "keywords": [
        "repository",
        "pinia"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        },
        "./src/*": "./src/*",
        "./dist/*": "./dist/*"
    },
    "main": "./dist/index.umd.js",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            "*": [
                "dist/index.d.ts"
            ]
        }
    },
    "files": [
        "*.d.ts",
        "dist",
        "src"
    ],
    "engines": {
        "node": ">= 19.x"
    },
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "type-check": "tsc --noEmit",
        "dev": "vite build --watch",
        "build": "vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "credits": "npx @opengovsg/credits-generator"
    },
    "peerDependencies": {
        "@volverjs/data": "^2.0.1",
        "@vueuse/core": "^13.0.x",
        "pinia": "^3.0.x",
        "vue": "^3.5.x"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.0.0",
        "@nabla/vite-plugin-eslint": "^3.0.1",
        "@pinia/testing": "^1.0.3",
        "@types/node": "^26.0.0",
        "@vitejs/plugin-vue": "^6.0.7",
        "@volverjs/data": "^2.0.5",
        "@vue/language-core": "^3.3.5",
        "@vue/shared": "^3.5.38",
        "@vue/test-utils": "^2.4.11",
        "@vueuse/core": "^14.3.0",
        "copy": "^0.3.2",
        "eslint": "^10.5.0",
        "happy-dom": "^20.10.4",
        "pinia": "^3.0.4",
        "typescript": "6.0.3",
        "unplugin-dts": "1.0.3",
        "vite": "^8.0.16",
        "vitest": "^4.1.9",
        "vitest-fetch-mock": "^0.4.5",
        "vue": "^3.5.38",
        "vue-tsc": "^3.3.5"
    }
}
